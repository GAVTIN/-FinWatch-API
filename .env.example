# Server
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/finwatch

# Auth
JWT_SECRET=replace_with_strong_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_strong_random_string
JWT_REFRESH_EXPIRES_IN=7d

# External APIs — get free key at alphavantage.co
ALPHA_VANTAGE_KEY=2F0K75GOPTMT5VLT

# Redis — required from Phase 3 onwards
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging — debug | info | warn | error
LOG_LEVEL=debug